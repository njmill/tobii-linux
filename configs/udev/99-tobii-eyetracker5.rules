# Tobii Eye Tracker 5 / EyeChip
# Allows the active local desktop session to access the vendor interface through libusb.
# MODE is intentionally permissive as a fallback for distros without logind/uaccess.
SUBSYSTEM=="usb", ATTR{idVendor}=="2104", ATTR{idProduct}=="0313", MODE="0666", TAG+="uaccess"
